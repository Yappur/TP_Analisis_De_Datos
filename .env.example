# Proveedor compatible con la API de OpenAI (la clave se conserva solo en el servidor)
CHATBOT_API_BASE_URL=https://api.openai.com/v1
CHATBOT_API_KEY=
CHATBOT_MODEL=
CHATBOT_EMBEDDING_MODEL=

# Recuperación vectorial local
CHATBOT_TOP_K=5
CHATBOT_SIMILARITY_THRESHOLD=0.30

# Token administrativo independiente para POST /api/chat/reindex
CHATBOT_REINDEX_TOKEN=
